GROQ_API_KEY=gsk_xxx
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
EMBED_MODEL=BAAI/bge-m3
TOP_K=5
# Vector store: qdrant | numpy
VECTOR_STORE=qdrant
QDRANT_COLLECTION=legal_vn
# Để trống = local mode (mặc định in-memory, dùng cho HF Spaces)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=:memory:
# Server ở máy bạn:  QDRANT_URL=http://localhost:6333
# Qdrant Cloud:      QDRANT_URL=https://<cluster>.cloud.qdrant.io  + QDRANT_API_KEY
